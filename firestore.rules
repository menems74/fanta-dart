rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function hasAccount() {
      return request.auth != null
        && exists(/databases/$(database)/documents/accounts/$(request.auth.uid));
    }
    function isAdmin() {
      return hasAccount()
        && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.ruolo == 'admin';
    }

    // Chi e' "Solo allenamenti" non vede stagioni, partite e pagelle di Fanta Dart.
    function isTeam() {
      return hasAccount()
        && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.ruolo != 'allenamenti';
    }

    function validCard(c) {
      return c.voto is int && c.voto >= 1 && c.voto <= 10
        && c.singoliGiocati is int && c.singoliGiocati >= 0 && c.singoliGiocati <= 4
        && c.singoliVinti is int && c.singoliVinti >= 0 && c.singoliVinti <= c.singoliGiocati
        && c.doppiGiocati is int && c.doppiGiocati >= 0 && c.doppiGiocati <= 2
        && c.doppiVinti is int && c.doppiVinti >= 0 && c.doppiVinti <= c.doppiGiocati;
    }

    function myPlayerId() {
      return get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.playerId;
    }

    // Ruolo di ogni account di accesso (uid Firebase -> giocatore). Lo scrivono solo gli admin.
    match /accounts/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // PIN in chiaro: lo leggono solo gli admin; ognuno può aggiornare il proprio quando lo cambia.
    match /pins/{playerId} {
      allow read, delete: if isAdmin();
      allow create, update: if (isAdmin() || (hasAccount() && myPlayerId() == playerId))
        && request.resource.data.pin is string
        && request.resource.data.pin.matches('^[0-9]{4}$');
    }

    // Allenamenti: una sessione per ogni gioco finito. Ognuno scrive le proprie, tutti le leggono.
    // Nel 501 in due si salva anche il risultato del compagno, segnando chi l'ha inserito.
    match /sessioni/{id} {
      allow read: if hasAccount();
      allow create: if hasAccount()
        && (request.resource.data.playerId == myPlayerId()
          || (request.resource.data.gioco == 'x501' && request.resource.data.inseritoDa == myPlayerId()))
        && request.resource.data.gioco in ['x501', 'target20', 'targetbull', 'scoring', 'checkout', 'doppie', 'rotation', 'cricket']
        && request.resource.data.valore is number && request.resource.data.valore >= 0
        && request.resource.data.voto is number && request.resource.data.voto >= 0 && request.resource.data.voto <= 100;
      allow update, delete: if hasAccount()
        && (resource.data.playerId == myPlayerId() || resource.data.get('inseritoDa', '') == myPlayerId() || isAdmin());
    }

    match /players/{id} {
      allow read: if hasAccount();
      allow write: if isAdmin();
    }

    match /seasons/{id} {
      allow read: if isTeam();
      allow write: if isAdmin();
    }

    // I Player vedono solo le serate pubblicate.
    match /matches/{id} {
      allow read: if isAdmin() || (isTeam() && resource.data.pubblicata == true);
      allow write: if isAdmin();
    }

    match /reportCards/{id} {
      allow read: if isAdmin() || (isTeam() && resource.data.pubblicata == true);
      // Voto 1-10; al massimo 4 singoli e 2 doppi giocati, con vittorie non superiori ai giocati.
      allow create, update: if isAdmin() && validCard(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
